<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_settings_freshdesk" model="ir.ui.view">
        <field name="name">res.config.settings.freshdesk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Freshdesk" name="freshdesk">
                    <block title="Freshdesk Integration">
                        <setting>
                            <field name="freshdesk_domain"/>
                        </setting>
                        <setting>
                            <field name="freshdesk_api_key" password="True"/>
                        </setting>
                        <div class="mt16">
                            <button name="action_export_contacts"
                                type="object"
                                string="Export Contacts"
                                class="btn-primary"/>
                            <button name="action_import_contacts"
                                type="object"
                                string="Import Contacts"
                                class="btn-secondary"/>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>